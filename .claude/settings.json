{
  "permissions": {
    "ask": ["Bash(git commit *)", "Bash(git push *)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --frozen --quiet python \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_migrations.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --frozen --quiet python \"$CLAUDE_PROJECT_DIR/.claude/hooks/lint_changed_file.py\"",
            "timeout": 60,
            "statusMessage": "ruff on the changed file"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --frozen --quiet python \"$CLAUDE_PROJECT_DIR/.claude/hooks/check_on_stop.py\"",
            "timeout": 300,
            "statusMessage": "mypy + architecture and unit tests"
          }
        ]
      }
    ]
  }
}
